rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'tzevet@kinus-hashluchim.app'
        ];
    }

    match /public/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff();
    }

    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['vid', 'name', 'cls', 'at'])
        && request.resource.data.vid is string && request.resource.data.vid.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 40
        && request.resource.data.at is number;
    }

    match /{collection}/{docId} {
      allow read, write: if isStaff();
    }
  }
}
